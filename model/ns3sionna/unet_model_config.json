{
  "version": 1,
  "name": "rss_unet_height_cond_v1",

  "paths": {
    "torchscript_model": "runs/height_cond/model.pt",
    "norm_stats_npz": "runs/height_cond/norm_stats.npz"
  },

  "runtime": {
    "device": "cuda:0",
    "features": ["cost", "height_cond"],

    "grid": {
      "H": 64,
      "W": 64,
      "cell_size_m": 0.625,
      "origin_policy": "fit_points",
      "origin_margin_cells": 2
    },

    "height": {
      "policy": "per_receiver_bucket",
      "bucket_m": 0.25,
      "clamp_margin_m": 0.1
    }
  },

  "calibration": {
    "train_frequency_hz": 2000000000.0,
    "train_tx_power_dbm": 44.0,
    "runtime_tx_power_dbm": 44.0,
    "frequency_correction": "friis"
  },

  "link": {
    "delay_policy": "distance_over_c",
    "loss_policy": "tx_minus_rss"
  }
}
